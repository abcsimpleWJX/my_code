#include <stdio.h>

// 辅助函数：翻转数组区间 [left, right]
void reverse(int arr[], int left, int right) {
    while (left < right) {
        int temp = arr[left];
        arr[left] = arr[right];
        arr[right] = temp;
        left++;
        right--;
    }
}

int main() {
    int n;
    long long k;
    if (scanf("%d %lld", &n, &k) != 2) return 0;

    int a[1005];
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    k = k % n; // 取模
    
    if (k != 0) { // 如果 k 是 0，不需要翻转
        reverse(a, 0, n - 1);       // 1. 翻转整个数组
        reverse(a, 0, k - 1);       // 2. 翻转前 k 个
        reverse(a, k, n - 1);       // 3. 翻转剩下的 n-k 个
    }

    // 输出结果
    for (int i = 0; i < n; i++) {
        if (i > 0) printf(" ");
        printf("%d", a[i]);
    }
    printf("\n");

    return 0;
}
