#include <stdio.h>

int main() {
    int n;
    long long k;
    if (scanf("%d %lld", &n, &k) != 2) return 0;

    int a[1005];
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    k = k % n;
    
    int b[1005];
    for (int i = 0; i < n; i++) {
        b[(i + k) % n] = a[i];
    }

    for (int i = 0; i < n; i++) {
        if (i > 0) printf(" ");
        printf("%d", b[i]);
    }
    printf("\n");

    return 0;
}
