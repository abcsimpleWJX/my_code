#include <stdio.h>

int main() {
    int n;
    
    if (scanf("%d", &n) != 1) return 0;

    int arr[105]; 

  
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

   
    int j = 0;
    for (int i = 0; i < n; i++) {
        if (arr[i] != 0) {
            arr[j] = arr[i];
            j++;
        }
    }

    while (j < n) {
        arr[j] = 0;
        j++;
    }

    
    for (int i = 0; i < n; i++) {
        if (i == n - 1) {
            printf("%d", arr[i]); 
        }
        else {
            printf("%d ", arr[i]);  
        }
    }

    return 0;
}
