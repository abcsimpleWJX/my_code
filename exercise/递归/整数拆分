#include <stdio.h>
int n;
void dfs(int rest, int maxv, int path[], int len) {
	if (rest == 0) {
		printf("%d=%d", n, path[0]);
		for (int i = 1;i < len;i++) {
			printf("+%d", path[i]);
		}
		printf("\n");
		return;
	}
	for (int i = maxv;i >= 1;i--) {
		if (i > rest) continue;
		path[len] = i;
		dfs(rest - i, i, path, len + 1);
	}
}
int main()
{
	int path[20];
	scanf("%d", &n);
	dfs(n, n - 1, path, 0);
	return 0;
}
