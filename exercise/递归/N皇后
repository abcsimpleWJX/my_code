#include <stdio.h>
#include <stdlib.h>
int n;
int count = 0;
int queen[15];
int check(int row, int col)
{
	for (int i = 0;i < row;i++)
	{
		if (queen[i] == col || abs(i - row) == abs(queen[i] - col))
			return 0;
	}
	return 1;
}
void dfs(int row)
{
	if (row == n)
	{
		count++;
		return;
	}
	for (int col = 0;col < n;col++)
	{
		if (check(row, col)) {
			queen[row] = col;
			dfs(row + 1);
		}
	}
}
int main()
{
	scanf("%d", &n);
	count = 0;
	dfs(0);
	printf("%d", count);
	return 0;
}
