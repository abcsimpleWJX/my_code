#include <stdio.h>
int arr[5005] = {0};
int main()
{
	int n;
	scanf("%d",&n);
	arr[0] = 1;
	arr[1] = 1;
	for (int i = 2;i * i <= n;i++) {
		if (arr[i] == 0) {
			for (int j = i * i;j <= n;j += i) {
				arr[j] = 1;
			}
		}
	}
	int count=0;
	for (int i = 2;i <= n;i++) {
		if (!arr[i])
			count++;

	}
	printf("%d", count);
}
