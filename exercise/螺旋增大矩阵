#include <stdio.h>
int main() {
	int n;
	scanf("%d", &n);
	int matrix[35][35] = { 0 };
	int dx[] = { 0, 1, 0, -1 };
	int dy[] = { 1, 0, -1, 0 };
	int x = 0, y = 0;
	int d = 0;
	for (int i = 1;i <= n * n;i++) {
		matrix[x][y] = i;
		int nx = x + dx[d];
		int ny = y + dy[d];
		if (nx < 0 || nx >= n || ny < 0 || ny >= n || matrix[nx][ny] != 0) {
			d = (d + 1) % 4;
			nx = x + dx[d];
			ny = y + dy[d];
		}
		x = nx;
		y = ny;

	}
	for (int i = 0;i < n ;i++) {
		for (int j = 0;j < n;j++) {
			printf("%4d", matrix[i][j]);
		}
		printf("\n");
	}
	return 0;
}
