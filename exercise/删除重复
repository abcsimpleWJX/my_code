#include <stdio.h>
int main()
{
	int n;
	scanf("%d", &n);
	int arr[105];
	for (int i = 0;i < n;i++) {
		scanf("%d", &arr[i]);
	}
	int k = 0;
	for (int i = 1;i < n;i++) {
		int flag = 0;
		for (int j = 0;j <= k; j++) {
			if (arr[i] == arr[j]) {
				flag = 1;
				break;
			}
		}
		if (!flag) {
			k++;
			arr[k] = arr[i];
		}
	}
	for (int i = 0;i <= k;i++) {
		if (i == 0)
			printf("%d", arr[i]);
		else
			printf(" %d", arr[i]);
	}
	return 0;
}
