/*题目名称：删除重复元素

题目描述：编写函数，不使用其他辅助数组，把整型数组中重复元素删得只剩一个；
所有未被删除元素都保留最先顺序移动到数组前面。
输入：第一行输入数组长度n（≤100），第二行依次从键盘随机输入n个整数作为数组元素值。
输出：已删除重复元素的数组，各元素间以一个西文空格间隔，最后一个元素后无字符。

输入：
10
1 1 2 3 3 3 2 1 2 4
输出：
1 2 3 4

输入：
10
1 0 2 2 2 2 2 2 2 2
输出：
1 0 2
*/
#include <stdio.h>
int main()
{
	int n;
	scanf("%d", &n);   //n表示有几个数字
	int arr[105];
	for (int i = 0;i < n;i++) {
		scanf("%d", &arr[i]);      //把n个数字存入数组
	}
	int k = 0;   //用k表示不重复数组(称做新数组吧)的索引
	for (int i = 1;i < n;i++) {  //0号位肯定不重复,拿1号位后的一个一个比对
		int flag = 0;                //用flag=0表示不重复
		for (int j = 0;j <= k; j++) {    //这里j到k是新数组索引,一开始只有arr[0]
			if (arr[i] == arr[j]) {
				flag = 1;  //如果相同,用flag=1记录,直接跳出
				break;
			}
		}
		if (!flag) {  //不重复
			k++;      //把k扩充一位给新元素  
			arr[k] = arr[i];  //记录
		}
	}
	for (int i = 0;i <= k;i++) {
		if (i == 0)
			printf("%d", arr[i]);
		else
			printf(" %d", arr[i]);
	}
	return 0;
}
